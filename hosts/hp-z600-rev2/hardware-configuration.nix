  boot.extraModulePackages = [ ];

  fileSystems."/" =
    { device = "/dev/mapper/GLaDOS_lvm-GLaDOS_rootfs";
      fsType = "btrfs";
      options = [ "subvol=@" ];
    };

  fileSystems."/home" =
    { device = "/dev/mapper/GLaDOS_lvm-GLaDOS_rootfs";
      fsType = "btrfs";
      options = [ "subvol=@home" ];
    };

  fileSystems."/nix" =
    { device = "/dev/mapper/GLaDOS_lvm-GLaDOS_rootfs";
      fsType = "btrfs";
      options = [ "subvol=@nix" ];
    };

  fileSystems."/persist" =
    { device = "/dev/mapper/GLaDOS_lvm-GLaDOS_rootfs";
      fsType = "btrfs";
      options = [ "subvol=@persist" ];
    };

  fileSystems."/var/log" =
    { device = "/dev/mapper/GLaDOS_lvm-GLaDOS_rootfs";
      fsType = "btrfs";
      options = [ "subvol=@log" ];
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/04143cda-e18a-434d-8510-39ee3c89a66d";
      fsType = "ext4";
    };

  swapDevices =
    [ { device = "/dev/mapper/GLaDOS_lvm-GLaDOS_swap"; }
    ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
