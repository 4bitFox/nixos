--- a/ucm2/Intel/sof-hda-dsp/sof-hda-dsp.conf
+++ b/ucm2/Intel/sof-hda-dsp/sof-hda-dsp.conf
@@ -1,4 +1,4 @@
-Syntax 7
+Syntax 8
 
 Include.led.File "/common/ctl/led.conf"
 Include.card-init.File "/lib/card-init.conf"
